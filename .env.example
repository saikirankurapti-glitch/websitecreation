# ------ HubSpot CRM ------
HUBSPOT_ACCESS_TOKEN=pat-na1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------ Mailchimp Newsletter ------
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx
